**/*.exe
**/*.dll
**/*.asi
**/*.tga
**/*.png
**/*.wav
**/*.mp3
**/*.ttf
**/*.fot
**/*.psd
**/*.pdn
**/*.mov

# Local tooling and IDE state.
.vs/
.vscode/
CMakeUserPresets.json
__pycache__/
*.pyc
